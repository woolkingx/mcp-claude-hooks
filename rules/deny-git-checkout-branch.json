{
  "name": "deny-git-checkout-branch",
  "description": "Block git checkout (use worktree)",
  "enabled": false,
  "event": "PreToolUse",
  "priority": 80,
  "tool": "Bash",
  "action": "deny",
  "reason": "Use git worktree instead of git checkout.\nNEVER switch branches — use worktree architecture.",
  "match_bash": {
    "allOf": [
      {
        "properties": {
          "name": {
            "properties": {
              "text": {
                "const": "git"
              }
            }
          }
        },
        "required": [
          "name"
        ]
      },
      {
        "properties": {
          "suffix": {
            "type": "array",
            "contains": {
              "properties": {
                "text": {
                  "const": "checkout"
                }
              }
            }
          }
        }
      }
    ]
  }
}
