{
  "name": "ask-config-modify",
  "description": "Ask before modifying config files",
  "enabled": false,
  "event": "PreToolUse",
  "priority": 70,
  "tool": [
    "Write",
    "Edit"
  ],
  "action": "ask",
  "reason": "Modifying config file requires confirmation.",
  "match": {
    "properties": {
      "tool_input": {
        "properties": {
          "file_path": {
            "type": "string",
            "pattern": "(\\.env$|\\.ini$|\\.yml$|\\.yaml$|settings\\.json$)"
          }
        }
      }
    }
  }
}
